# Server
PORT=5000
NODE_ENV=development

MONGODB_URI=mongodb://127.0.0.1:27017/linkedin-profile-api

# ─── LinkedIn cookies ───────────────────────────────────────────────────────
# Option A (recommended): ONE line — entire browser cookie string
# LI_COOKIE=li_at=PASTE_VALUE; JSESSIONID="ajax:..."; bcookie="..."; bscookie="..."; lidc="..."
#
# Option B (below): separate vars — easier to edit

LI_AT=PASTE_YOUR_li_at_VALUE_HERE
JSESSIONID=ajax:PASTE_YOUR_JSESSIONID_VALUE_HERE
LI_EXTRA_COOKIES=bcookie="PASTE_VALUE"; bscookie="PASTE_VALUE"; lidc="PASTE_VALUE"

LINKEDIN_REQUEST_DELAY_MS=1500
# Safety switch: live authenticated requests are off by default.
LINKEDIN_ENABLE_LIVE_REQUESTS=false
LINKEDIN_USE_ENRICHMENT=false
LINKEDIN_USE_GRAPHQL=false

CACHE_TTL_SECONDS=3600
CLIENT_URL=http://localhost:5173
API_KEY=
